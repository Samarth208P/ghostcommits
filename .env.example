# Exact public HTTPS origin on Netlify; localhost is only for npm run dev.
APP_ORIGIN=http://localhost:5173
PORT=3001

# One public GitHub App registered by the site operator.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the full PEM as a secret in Netlify. Literal \n escapes are also supported.
GITHUB_APP_PRIVATE_KEY=
# Local alternative to the PEM environment variable:
GITHUB_APP_PRIVATE_KEY_PATH=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Netlify provisions NETLIFY_DB_URL automatically; do not commit its value.
# NETLIFY_DB_URL=

# Optional legacy local pilot only. Hosted maintainers do not need these.
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
SPONSOR_TOKEN=
